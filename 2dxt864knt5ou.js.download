    query SelfServeEnterpriseOnboardingTour($orgId: String, $isOrgAnchoredPath: Boolean!) {
  currentUser {
    id
    hasUserCompletedOnboarding
    customer {
      id
      authorizations {
        upgradeWelcomeTourVariant
      }
    }
    org(orgId: $orgId) @include(if: $isOrgAnchoredPath) {
      ... on Org {
        id
        slug
        authorizations {
          seeSelfServeEnterpriseOnboarding {
            isAuthorized
          }
        }
      }
    }
    selfServeEnterpriseOnboardingOrg @skip(if: $isOrgAnchoredPath) {
      ... on Org {
        id
        slug
      }
    }
    toursSeen(
      tours: ["unified-plans-welcome-to-core", "unified-plans-welcome-to-pro"]
    ) {
      id
      seen
    }
  }
}
