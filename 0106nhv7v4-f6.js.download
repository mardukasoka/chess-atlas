        usageBasedBillingBudget {
          __typename
          ... on UsageBasedBillingBudget {
            ...StartWithAiUsageBudget
          }
          ... on Error {
            message
          }
        }
        customer {
          ... on Customer {
            ...EditUsageBasedBillingAlertsFormCustomerAlerts
          }
          ... on Error {
            message
          }
        }
      }
      ... on Error {
        message
      }
    }
  }
}
