    query PlanGridCurrentUser($isDowngradeEnabled: Boolean = false, $includeStarterPlanAuthorization: Boolean = false) {
  currentUser {
    id
    isSubscribed
    isRazorpayPaymentProcessor
    userSubscriptionType
    scheduledDowngrade @include(if: $isDowngradeEnabled) {
      ...ScheduledDowngradeBanner_scheduledDowngrade
    }
    billingInfo {
      planInfo {
        interval
        externalId
      }
    }
    customer {
      id
      proTierDowngradesEnabled: isGateEnabled(gate: "gate_pro_tier_downgrades_server") @include(if: $isDowngradeEnabled)
      authorizations {
        viewStarterPlanUsage @include(if: $includeStarterPlanAuthorization) {
          isAuthorized
        }
        downgradeSubscription {
          isAuthorized
        }
      }
      billing {
        __typename
        ... on CustomerBilling {
          arrangement {
            __typename
            ... on CustomerSelfServeSubscription {
              subscriptionEndDate
            }
          }
        }
      }
    }
  }
}
