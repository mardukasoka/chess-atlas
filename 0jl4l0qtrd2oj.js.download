    mutation CreateAgentReplCreateRepl($input: CreateReplInput!) {
  createRepl(input: $input, isTitleAutoGenerated: false) {
    __typename
    ... on Repl {
      id
      title
      config {
        zealot
        agentHarness
      }
      owner {
        __typename
        ... on Team {
          id
        }
        ... on User {
          id
        }
      }
      authorizations {
        configureAgentModelSettings {
          isAuthorized
        }
        star {
          isAuthorized
        }
        deleteRepl {
          isAuthorized
        }
        editMetadata {
          isAuthorized
        }
        fork {
          isAuthorized
        }
        removeSelf {
          isAuthorized
        }
        transferOwnership {
          isAuthorized
        }
      }
      currentUserSettings {
        visibleAgentModelsByMode {
          mode
          tiers {
            tier
            models {
              model
              label
              isDefault
              provider
              relativeCost
              recommendedEffort
              authorization {
                isAuthorized
                code
                message
              }
            }
          }
        }
      }
      ...ReplLinkRepl
      ...ReplsListRepl
      ...ForkContextRepl
      ...EditReplFormRepl
      ...DeleteReplDialogRepl
      ...LeaveMultiplayerReplDialogRepl
      ...TransferReplWithinOrgDialogRepl
      ...TransferReplToOrgDialogRepl
      ...TransferReplBetweenWorkspacesDialogRepl
    }
    ... on UserError {
      message
    }
  }
}
