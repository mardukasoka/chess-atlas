    mutation BigQuerySetServiceAccountRedirect($input: SetConnectionProxyRedirectInput!) {
  setConnectionProxyRedirect(input: $input) {
    __typename
    ... on SetConnectionProxyRedirect {
      success
    }
    ... on UserError {
      message
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
