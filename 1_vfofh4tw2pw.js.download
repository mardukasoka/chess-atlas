    query CreateRemoteFormUser($input: GitProviderContextInput) {
  currentUser {
    ... on CurrentUser {
      id
      gitHubInfoV2(input: $input) {
        organizations {
          id
          type
          avatarUrl
          name
        }
      }
      bitbucketInfo(input: $input) {
        workspacesToProjects {
          uuid
          name
          slug
          projects {
            uuid
            name
          }
        }
      }
      gitLabInfo(input: $input) {
        groups {
          namespaceId
          name
          visibility
          description
          avatarUrl
          webUrl
          fullName
          fullPath
        }
      }
    }
  }
}
