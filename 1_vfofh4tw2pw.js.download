        manageReplShieldTokens {
          isAuthorized
          code
          message
        }
      }
      replShieldTokens(after: $after, count: $count) {
        items {
          ...ReplShieldTokenRow_record
        }
        pageInfo {
          hasNextPage
          nextCursor
        }
      }
      hostingDeployment {
        ... on HostingDeployment {
          id
          replitAppSubdomain
          domains2 {
            id
            domain
            state
          }
          currentBuild {
            id
            provider
            isPrivate
          }
        }
      }
    }
    ... on Error {
      message
    }
  }
}
