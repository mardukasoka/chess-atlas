"use strict";(()=>{var B="0.6.1-standalone";var y={HIGHLIGHT_COLOR:"#0079F2",HIGHLIGHT_BG:"#0079F210",ALLOWED_PARENT_DOMAINS:[".replit.dev",".replit.com",".replit-staging.com",".replit.corp.repl.it",".rp-humain.com",".repl.co"],DEV_VM_WORKSPACE_PORT:"3000",THEME_PREVIEW_STYLE_ID:"replit-theme-preview",MAX_SIBLING_HIGHLIGHTERS:1e3,MAX_DESCENDANTS_FOR_SCREENSHOT:1500},ae=`
  [contenteditable] {
    outline: none !important;
  }

  [contenteditable]:focus {
    outline: none !important;
  }
`,ce=`
  .beacon-highlighter {
    content: '';
    position: absolute;
    z-index: ${Number.MAX_SAFE_INTEGER-3};
    box-sizing: border-box;
    pointer-events: none;
    outline: 1.5px dashed ${y.HIGHLIGHT_COLOR} !important;
    outline-offset: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
    background: ${y.HIGHLIGHT_BG} !important;
    opacity: 0;
  }
  
  .beacon-hover-highlighter {
    position: fixed;
    z-index: ${Number.MAX_SAFE_INTEGER};
  }
  
  .beacon-selected-highlighter {
    position: fixed;
    pointer-events: none;
    outline: 1.5px solid ${y.HIGHLIGHT_COLOR} !important;
    /* Same offset as the hover highlighter so the ring doesn't shift on
       click \u2014 only the dash pattern changes. */
    outline-offset: 0 !important;
    background: none !important;
  }
  
  .beacon-label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 4px;
    box-sizing: border-box;
    height: 24px;
    /* Element pill in the selection color, matching the highlight ring so
       chip + ring read as one selection system (same reason design tools
       label selections in their selection blue). Deliberately one constant
       palette in every theme: the pill floats over arbitrary mockup
       content, and solid selection-blue with white text holds contrast on
       any backdrop. */
    background-color: ${y.HIGHLIGHT_COLOR};
    color: #FFFFFF;
    padding: 0 8px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    /* Layered shadow, macOS-flavored depth \u2014 y doubles per step; blur
       stays in the 2-4x-of-y band with variety per layer (tight contact
       up to a wide ambient). The product Pill has none, but this one
       floats over arbitrary user content and needs real elevation. */
    box-shadow:
      0 1px 2px rgba(0,0,0,0.12),
      0 2px 6px rgba(0,0,0,0.10),
      0 4px 12px rgba(0,0,0,0.08),
      0 8px 32px rgba(0,0,0,0.10);
    margin-top: 6px;
    /* The outline paints outside the element box, so pull the chip left
       by the ring width to sit flush with its outer edge. */
    margin-left: -1.5px;
    left: 0;
    z-index: ${Number.MAX_SAFE_INTEGER-2};
    pointer-events: none;
    opacity: 0;
  }

  .beacon-label svg {
    flex: none;
    width: 14px;
    height: 14px;
  }


  
  .beacon-hover-label {
    position: fixed;
    z-index: ${Number.MAX_SAFE_INTEGER};
  }
  
  .beacon-selected-label {
    position: fixed;
    pointer-events: none;
  }
  
  .beacon-sibling-highlighter {
    position: fixed;
    pointer-events: none;
    outline: 1.5px dashed ${y.HIGHLIGHT_COLOR} !important;
    outline-offset: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
    background: ${y.HIGHLIGHT_BG} !important;
  }
