          authedLaunchUrl
          expiresAt
          hostingBuildId
          hostingDeploymentId
          framework
          launches {
            ios {
              ...ExpoLaunch
            }
          }
        }
        ... on PendingExpoLaunchSession {
          failed
        }
      }
    }
  }
}
