    query ChateauConversationConnectorAuthorization($orgId: String) {
  currentUser {
    id
    personalOrgId
    personalOrgAuthorizations {
      ... on OrgAuthorizations {
        paidAgent: useAiAgent(tier: paid) {
          isAuthorized
          code
        }
      }
      ... on Error {
        message
      }
    }
    org(orgId: $orgId) {
      ... on Org {
        id
        slug
        dealContext {
          dealType
        }
        authorizations {
          paidAgent: useAiAgent(tier: paid) {
            isAuthorized
            code
          }
        }
      }
      ... on Error {
        message
      }
    }
  }
