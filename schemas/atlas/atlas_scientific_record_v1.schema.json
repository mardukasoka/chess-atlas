{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mardukasoka/chess-atlas/schemas/atlas_scientific_record_v1.schema.json",
  "title": "AtlasScientificRecord",
  "description": "Canonical, versioned, bitemporal Atlas knowledge record. Additive: does not alter uranometria data shapes or atlas-matter catalogues. Status vocabulary reuses experiments/matter/phase-transition-schema.json v0.1; conventions follow harness2 ScientificToolRecord (draft 2020-12).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "source_id", "record_type", "timestamps", "confidence", "citations", "provenance", "historical_validity"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "source_id": {"type": "string", "minLength": 1, "description": "Stable source identifier, e.g. 'synthetic/ep1', 'messier:M31', 'doi:10.x/y'."},
    "record_type": {"enum": ["observation", "hypothesis", "simulation", "verified_outcome"]},
    "epistemic_status": {"enum": ["observed", "replicated", "candidate", "disputed", "theoretical"]},
    "subject": {"type": "string"},
    "claim": {"type": "string"},
    "physical_units": {"type": "array", "items": {"$ref": "#/$defs/quantity"}},
    "coordinates": {"oneOf": [{"$ref": "#/$defs/celestial"}, {"$ref": "#/$defs/cartesian"}]},
    "timestamps": {
      "type": "object", "additionalProperties": false, "required": ["recorded_at", "valid_from"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time", "description": "Transaction time"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "confidence": {
      "type": "object", "additionalProperties": false, "required": ["value", "method"],
      "properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "method": {"type": "string", "minLength": 1}}
    },
    "citations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
        "properties": {"kind": {"enum": ["doi", "url", "bibtex", "internal"]}, "ref": {"type": "string", "minLength": 1}, "note": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["agent_id", "timestamp", "action"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "action": {"enum": ["ingested", "parsed", "transformed", "derived", "simulated", "reviewed", "verified", "superseded"]},
          "input_ids": {"type": "array", "items": {"type": "string"}},
          "tool": {"type": "string"},
          "tool_version": {"type": "string"},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
        }
      }
    },
    "supersedes": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
    "superseded_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "historical_validity": {
      "type": "object", "additionalProperties": false, "required": ["valid_from"],
      "properties": {"valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "retained": {"const": true}}
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification": {"type": "object", "properties": {"domain": {"type": "string"}, "category": {"type": "string"}}, "additionalProperties": true}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "uncertainty": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {"kind": {"enum": ["symmetric", "asymmetric", "interval", "qualitative", "none"]}, "sigma": {"type": "number", "minimum": 0}, "plus": {"type": "number", "minimum": 0}, "minus": {"type": "number", "minimum": 0}, "confidence_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
    },
    "quantity": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "unit"],
      "properties": {"name": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "uncertainty": {"$ref": "#/$defs/uncertainty"}}
    },
    "celestial": {
      "type": "object", "additionalProperties": false, "required": ["ra_deg", "dec_deg", "epoch"],
      "properties": {"ra_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}, "dec_deg": {"type": "number", "minimum": -90, "maximum": 90}, "epoch": {"type": "string"}, "frame": {"type": "string"}}
    },
    "cartesian": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "frame"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}, "frame": {"type": "string"}, "unit": {"type": "string"}}
    }
  }
}
