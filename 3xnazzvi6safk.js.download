    query AutoOpenInviteNudgeCurrentUser($replId: String!, $isOrgRepl: Boolean!) {
  currentUser {
    id
    timeCreated
    replCount(includeOrgOwned: true) {
      ... on ReplCount {
        count
      }
    }
    customer @skip(if: $isOrgRepl) {
      ...InvitePromotionsCustomer
    }
  }
  getRepl(id: $replId) {
    ... on Repl {
      id
      org {
        id
        customer {
          ... on Customer {
            ...InvitePromotionsCustomer
          }
        }
      }
    }
