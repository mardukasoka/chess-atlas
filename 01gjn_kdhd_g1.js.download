    query HomeChatJumpBackInCard($count: Int!, $orgId: String!, $inOrg: Boolean!) {
  recentRepls(count: $count) @skip(if: $inOrg) {
    ...JumpBackInCardRepl
  }
  currentUser @include(if: $inOrg) {
    id
    org(orgId: $orgId) {
      ... on Org {
        id
        recentRepls(input: {count: $count}) {
          ... on ReplConnection {
            items {
              ...JumpBackInCardRepl
            }
          }
        }
      }
    }
